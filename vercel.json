{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "includeFiles": "public/build/**"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|ttf|woff|woff2|eot|otf|webp|avif|txt|json|map))$",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "BudgetKit",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_LOCALE": "en",
        "APP_MAINTENANCE_DRIVER": "cache",
        "APP_MAINTENANCE_STORE": "array",
        "DB_CONNECTION": "pgsql",
        "SESSION_DRIVER": "database",
        "SESSION_LIFETIME": "120",
        "SESSION_SECURE_COOKIE": "true",
        "MAIL_MAILER": "array",
        "CACHE_STORE": "array",
        "CACHE_DRIVER": "array",
        "QUEUE_CONNECTION": "sync",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "LOG_CHANNEL": "stderr",
        "LOG_STACK": "stderr",
        "LOG_EMERGENCY_PATH": "/tmp/laravel.log"
    }
}
